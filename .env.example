# fd-file-service 环境变量样例（任务 7.1）
#
# 用法：cp .env.example .env 后填真实值。.env 已 gitignore——**真实凭据永不入仓**。
# 所有键均有默认值，未设也能起（指向本地占位端点，上传会失败但健康检查 200）。

# ---- 存储（S3 兼容：RustFS / MinIO / 专业对象存储同接口）----
# 换存储只改这四个值，业务行为不变（design D3 / D11）。
FILE_S3_ENDPOINT=http://127.0.0.1:9000
FILE_S3_ACCESS_KEY=__FILL_ME__
FILE_S3_SECRET_KEY=__FILL_ME__
FILE_S3_BUCKET=fd-file
FILE_S3_REGION=us-east-1
# RustFS 实测必须 path-style；专业对象存储可改 virtual。
FILE_S3_ADDRESSING_STYLE=path

# ---- 配额（按 owner，去重后字节；design D6）----
FILE_QUOTA_FREE_BYTES=1073741824
FILE_QUOTA_BASIC_BYTES=5368709120
FILE_QUOTA_STANDARD_BYTES=10737418240
# 未显式指派的 owner 走此档：free / basic / standard / unlimited
FILE_QUOTA_DEFAULT_TIER=free
# 按 owner 覆盖档位，JSON；平台内部资产走 unlimited
FILE_QUOTA_TIER_OVERRIDES={}

# ---- 生命周期 ----
# 软删除保留天数（D8：防误删经双向同步网盘扩散）
FILE_SOFT_DELETE_DAYS=30
FILE_PRESIGN_UPLOAD_TTL_SECONDS=900

# ---- 上传校验 ----
FILE_MAX_UPLOAD_BYTES=2147483648
# 逗号分隔白名单；留空 = 不限类型
FILE_ALLOWED_MIMES=

# ---- 元数据（SQLite 单文件，design D5）----
FILE_DATABASE_URL=sqlite:///./fd_file_service.db

# ============================================================================
# 以下为「列表 / 取用 / 事件总线 / 解析管线」侧的环境变量
# （变更任务 4.1-4.2 / 5.1-5.3；由 fd_file_service/{list_access,events,parse}.py 读取）
# ============================================================================

# ---- 取用地址有效期（任务 4.2：不得返回永久公开地址）----
# 默认 3600 秒（1 小时）。调用方可用 ?ttl= 请求更短的有效期；
# 请求超过上限时被夹到上限，且响应里的 expires_in 与实际签名时长一致。
FILE_ACCESS_URL_TTL_SECONDS=3600
# 单次请求允许的最长有效期（秒）——防止调用方变相拿到长期公开地址。
FILE_ACCESS_URL_MAX_TTL_SECONDS=86400

# ---- 事件总线（任务 5.1）----
# 进程内事件总线 + 可插拔持久化后端，v1 不引入 Kafka / Redis / RabbitMQ。
#   sqlite = SQLite 队列表（默认，跨进程、带租约认领与重试预算）
#   memory = 纯内存（仅测试，进程重启即失）
FILE_EVENT_BACKEND=sqlite
# 事件库 URL；留空则跟随 FILE_DATABASE_URL（同一 SQLite 文件，不多一处备份面）
FILE_EVENT_DB_URL=
# 单条事件最多投递几次；超过则进死信（status=dead），不无限重试
FILE_EVENT_MAX_ATTEMPTS=3
# 认领租约时长（秒）；worker 崩溃后过期，事件自动回到待处理
FILE_EVENT_LEASE_SECONDS=300

# ---- 解析管线（任务 5.2 / 5.3）----
# 总开关；false 则 worker 直接退出且事件不被消费（保留在队列中）
FILE_PARSE_ENABLED=true
# 超过此体积（字节）跳过解析，避免单文件拖垮 worker（默认 50MB）
FILE_PARSE_MAX_BYTES=52428800
# 解析留痕表所在的库；留空则跟随 FILE_DATABASE_URL
FILE_PARSE_DB_URL=
# 文本产物的键前缀，最终键形如 <prefix><owner_hash>/<file_id>.txt
# 可设成 parsed/ 以便对产物整体配置对象存储生命周期规则
FILE_PARSE_TEXT_PREFIX=

# ---- Gotenberg（任务 6.1：需由用户在 存储主机 部署）----
# 该机 3000 端口被其它在用应用占用——Gotenberg 宿主端口定 3010（避开即可，
# 不用动那个应用）。起容器：
#   docker run -d --name gotenberg --restart unless-stopped -p 3010:3000 gotenberg/gotenberg:8
# 验证：  curl http://localhost:3010/health   （期望返回健康）
# 未部署时 Office 文件无法转 PDF，但**原生 PDF 仍可完成文本抽取**
# （原因见 fd_file_service/parsers/__init__.py：Gotenberg 无文本抽取端点）
FILE_GOTENBERG_URL=http://localhost:3010
FILE_GOTENBERG_TIMEOUT_SECONDS=120

# ---- PDF 文本抽取后端（软依赖，三选一；都不装则 PDF 抽不出文本）----
# 推荐 pymupdf（布局与 CJK 最好），次选 pdfminer.six（纯 Python），
# 兜底 pypdf。项目中择一安装即可，不必三者共存。
#   pip install pymupdf        # 或 pdfminer.six / pypdf
# 三者均不做 OCR——影印型 PDF 会抽出空文本，这记为 empty 而非 failed（OCR 属 v2）。
