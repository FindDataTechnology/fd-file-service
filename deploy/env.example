# fd-file-service 生产环境变量模板（节点侧）。
# 复制为 deploy/.env 后逐项填写；compose 同时用本文件做变量插值（${FD_FILE_IMAGE}
# 等）与容器的 env_file。
#
# 真实凭据只放这份 .env，不进仓（已被 fd-file-service 仓 .gitignore 覆盖：
# 同目录 .env 匹配）。

# ---- compose 插值 ----
# 构建池出片的镜像引用（fd-build-snapshot 产出，形如 <registry>/yizuo/fd-file-service:<sha>）
FD_FILE_IMAGE=
# 端口发布形态：默认仅绑回环（节点上反代转发）；见 deploy/compose.yml 注释
FD_FILE_BIND=127.0.0.1
FD_FILE_PORT=8731

# ---- 存储（S3 兼容；换存储只改这五个值，业务行为不变）----
# windows-laptop 的 RustFS 经 tailnet 直连（cheap-1 在 tailnet 内）
FILE_S3_ENDPOINT=http://100.64.0.10:9000
FILE_S3_ACCESS_KEY=
FILE_S3_SECRET_KEY=
# 生产桶名（与 fd-text 等既有桶隔离；harbor 桶永不触碰）
FILE_S3_BUCKET=fd-file
FILE_S3_REGION=us-east-1
# RustFS 实测必须 path-style
FILE_S3_ADDRESSING_STYLE=path

# ---- 单文件与配额 ----
FILE_MAX_UPLOAD_BYTES=104857600
# 上传凭据（预签名 URL）有效期（秒）
FILE_PRESIGN_UPLOAD_TTL_SECONDS=900
# 三档（字节）：free 1G / basic 5G / standard 10G；unlimited 为平台内部档
FILE_QUOTA_FREE_BYTES=1073741824
FILE_QUOTA_BASIC_BYTES=5368709120
FILE_QUOTA_STANDARD_BYTES=10737418240
FILE_QUOTA_DEFAULT_TIER=free
# 按 owner 覆盖档位（JSON，如 {"wire:cust_x":"standard"}；留空 = 全走默认档）
FILE_QUOTA_TIER_OVERRIDES=
# 允许的 MIME 列表（逗号分隔；留空 = 不限制）
FILE_ALLOWED_MIMES=
# 确认时是否下载字节校验 sha256（默认 false：字节不经服务，信任客户端声明）
FILE_VERIFY_SHA256_ON_CONFIRM=false
# 软删除保留天数（恢复窗口；备份方案的关键补丁，勿设 0）
FILE_SOFT_DELETE_DAYS=30
# 取用地址默认/最大有效期（秒）
FILE_ACCESS_URL_TTL_SECONDS=3600
FILE_ACCESS_URL_MAX_TTL_SECONDS=86400

# ---- 元数据库（容器内路径；compose 已挂 /data 卷）----
FILE_DATABASE_URL=sqlite:////data/fd_file_service.db

# ---- 事件总线 ----
FILE_EVENT_BACKEND=sqlite
# 事件库留空 = 跟随 FILE_DATABASE_URL（同一 SQLite 文件，不多一处备份面）
FILE_EVENT_DB_URL=
FILE_EVENT_MAX_ATTEMPTS=3
FILE_EVENT_LEASE_SECONDS=300

# ---- 解析管线 ----
FILE_PARSE_ENABLED=true
FILE_PARSE_MAX_BYTES=52428800
FILE_PARSE_DB_URL=
FILE_PARSE_TEXT_PREFIX=
# Gotenberg 部署后填实际端口（windows-laptop 的 3000 被占用，清单定 3010）
FILE_GOTENBERG_URL=http://100.64.0.10:3010
FILE_GOTENBERG_TIMEOUT_SECONDS=120
